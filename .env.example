# ==============================================================================
# Bijli Mitra (cms_dev) Local Environment Configuration Template
# DO NOT COMMIT ACTUAL PASSWORDS OR PRODUCTION CREDENTIALS
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000

# Local Development Database Configuration (cms_dev)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cms_dev
DB_USER=cms_dev_user
DB_PASSWORD=your_local_dev_password_here
DB_CONNECTION_LIMIT=10

# Security & Authentication
JWT_SECRET=your_local_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Uploads Configuration
UPLOAD_DIR=./uploads/complaintdocs
MAX_FILE_SIZE_BYTES=5242880
